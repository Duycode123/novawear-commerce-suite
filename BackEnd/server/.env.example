# ===== Application =====
APP_NAME=novawear-commerce-backend
NODE_ENV=development

# Production identity safety. This value must remain false in production;
# startup refuses known demo accounts and requires the private bootstrap admin.
ALLOW_DEMO_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-random-password
BOOTSTRAP_ADMIN_PASSWORD_VERSION=1
BOOTSTRAP_ADMIN_NAME=Quản trị NOVAWEAR
BOOTSTRAP_ADMIN_PHONE=
PORT=5000
APP_TIME_ZONE=Asia/Ho_Chi_Minh
REQUEST_BODY_LIMIT=1mb
FRONTEND_BASE_URL=http://localhost:3000
TRUST_PROXY=false

# ===== Authentication / JWT =====
# Production: use a unique random value with at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=novawear_refresh
# Production cross-origin (Vercel -> Render): Secure=true, SameSite=None.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
EXPOSE_VERIFICATION_CODE=false
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=60
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OPERATIONS_HANDOFF_TTL_SECONDS=60
GUEST_CHECKOUT_TOKEN_TTL_SECONDS=900
CHECKOUT_RESUME_TTL_SECONDS=1800
CHECKOUT_REQUEST_WINDOW_SECONDS=900
CHECKOUT_MAX_CODE_REQUESTS=5

# ===== Browser access / CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Email / SMTP =====
# Gmail requires 2-Step Verification and a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=replace-with-an-app-password
MAIL_FROM="NOVAWEAR <your-account@gmail.com>"
MAIL_REPLY_TO=your-support-email@gmail.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# ===== Optional OAuth integrations =====
# Enable a provider only after its client ID, secret and callback URL are ready.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_CLIENT_ID=replace-with-your-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v20.0
OAUTH_SUCCESS_URL=http://localhost:3000/oauth/callback
OAUTH_FAILURE_URL=http://localhost:3000/dang-nhap

# ===== Optional Cloudinary storage =====
# Enables product, avatar, review and return-proof uploads.
CLOUDINARY_ENABLED=false
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
CLOUDINARY_PRODUCT_FOLDER=novawear/products
CLOUDINARY_AVATAR_FOLDER=novawear/avatars
CLOUDINARY_REVIEW_FOLDER=novawear/reviews
CLOUDINARY_RETURN_FOLDER=novawear/returns
UPLOAD_MAX_FILE_SIZE_MB=12
# Admin product uploads use a separate bucket from customer images.
# The defaults support a full catalog editing session without weakening customer limits.
UPLOAD_RATE_WINDOW_SECONDS=900
UPLOAD_PRODUCT_RATE_LIMIT=120
UPLOAD_CUSTOMER_RATE_LIMIT=30
# Product photos smaller than this on either edge are rejected to prevent blur.
# Set to 0 to accept every valid image under 12MB (useful for a demo catalog).
# Set to 1200 or higher when you want the API to enforce large originals.
UPLOAD_PRODUCT_MIN_EDGE_PX=0

# ===== Database / PostgreSQL =====
# Use "postgres" for PostgreSQL or "json" for the local fallback store.
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_NAME=postgres
DB_POOL_SIZE=10
DB_SSL=false
# Bật cả hai giá trị dưới đây khi deploy với Neon/PostgreSQL qua Internet.
DB_SSL_REJECT_UNAUTHORIZED=true

# ===== Local JSON fallback =====
# Used only when DB_TYPE=json.
DATA_FILE=./data/store.json

# ===== Payment / SePay =====
# All fields are required to enable bank transfer checkout.
# Configure SePay webhook to POST /api/payments/sepay/webhook and send:
# Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>
SEPAY_WEBHOOK_API_KEY=replace-with-your-sepay-webhook-api-key
# Transaction polling can be enabled without changing an existing SePay webhook.
SEPAY_API_POLLING_ENABLED=false
SEPAY_API_ACCESS_TOKEN=replace-with-your-sepay-api-access-token
SEPAY_API_ACCOUNT_NUMBER=replace-with-your-bank-account
SEPAY_QR_BANK_CODE=replace-with-your-bank-code
SEPAY_QR_BANK_ACCOUNT=replace-with-your-bank-account
SEPAY_QR_ACCOUNT_NAME=replace-with-your-account-name
SEPAY_QR_TEMPLATE=compact
# Tự hủy đơn chuyển khoản chưa thanh toán và hoàn tồn kho sau 30 phút.
ORDER_PAYMENT_EXPIRATION_SECONDS=1800

# ===== Shipping / GHN =====
# Set SHIPPING_PROVIDER=ghn after completing the address district/ward mapping.
SHIPPING_PROVIDER=manual
GHN_API_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_TOKEN=replace-with-your-ghn-token
GHN_SHOP_ID=replace-with-your-ghn-shop-id
GHN_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GHN_PAYMENT_TYPE_ID=1
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
GHN_SERVICE_TYPE_ID=2
GHN_DEFAULT_WEIGHT_GRAMS=500
GHN_DEFAULT_LENGTH_CM=25
GHN_DEFAULT_WIDTH_CM=20
GHN_DEFAULT_HEIGHT_CM=8
GHN_ITEM_WEIGHT_GRAMS=250

# ===== Refund payout provider (optional) =====
# SePay confirms incoming transfers; it does not send refunds from this checkout flow.
# Configure a payout provider adapter here. Until then, refunds require a bank reference entered by Admin.
REFUND_PROVIDER_URL=
REFUND_PROVIDER_SECRET=
