# Local: http://localhost:5000/api
# Vercel/production: use the public Render API URL, e.g. https://your-api.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_STOREFRONT_URL=http://localhost:3000
REACT_APP_BASENAME=

# 0 accepts valid images of any dimensions (the original file is preserved).
# Use 1200 or higher when the catalog must enforce large originals.
REACT_APP_UPLOAD_PRODUCT_MIN_EDGE_PX=0
